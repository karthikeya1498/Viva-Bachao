{
  "manifest_version": 3,
  "name": "Viva-Bachao | GitHub Project Intelligence",
  "version": "1.0.0",
  "description": "Analyze GitHub repositories, reconstruct execution workflows, and prepare for viva examinations with 1 click.",
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Analyze in Viva-Bachao",
    "default_icon": {
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://github.com/*",
    "http://localhost:5000/*",
    "http://localhost:5173/*"
  ]
}
